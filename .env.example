# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Authentication (JWT secret for jose + Google OAuth 2.0)
JWT_SECRET="your-super-secret-jwt-key-change-me"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Optional canonical origin override in production (e.g. https://your-app.onrender.com)
APP_URL=""

# Default Admin Account (used only for initial bootstrap before linking Google)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-admin-password"

# Google Gemini API (optional backup keys for automatic rotation on rate limit)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY_2=""

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"
